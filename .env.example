# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
GOOGLE_BOOKS_API_URL=https://www.googleapis.com/books/v1/volumes

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Database (auto-configured in docker-compose for local dev)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/google_books

# Redis (auto-configured in docker-compose for local dev)
# REDIS_URL=redis://localhost:6379

# Security (use strong secrets in production)
# JWT_SECRET=dev_jwt_secret_change_in_production
# SESSION_SECRET=dev_session_secret_change_in_production

# Backend port (frontend runs on 3000 via Vite)
PORT=3001

# CORS (auto-configured in docker-compose for local dev)
# CORS_ORIGIN=http://localhost:3000

# Frontend Environment Variables (VITE_ prefix required for Vite)
VITE_API_URL=http://localhost:3001
VITE_AUTH_LOGIN_URL=http://localhost:3001/auth/google
VITE_AUTH_ME_URL=http://localhost:3001/api/me
VITE_AUTH_LOGOUT_URL=http://localhost:3001/auth/logout
